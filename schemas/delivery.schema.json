{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery.schema.json",
  "title": "PACT Delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pact",
    "type",
    "vtc_id",
    "vtc_hash",
    "work_hash",
    "evidence",
    "signature"
  ],
  "properties": {
    "pact": {
      "type": "string"
    },
    "type": {
      "const": "Delivery"
    },
    "vtc_id": {
      "type": "string"
    },
    "vtc_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "work_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "work_uri": {
      "type": "string",
      "format": "uri"
    },
    "input_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "instrument_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_uri": {
          "type": "string",
          "format": "uri"
        }
      },
      "$comment": "Section 6. Tier-conditional members enforced in code."
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
