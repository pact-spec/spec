{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "verdict.schema.json",
  "title": "PACT Verdict (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pact",
    "type",
    "vtc_id",
    "delivery_hash",
    "outcome",
    "profile",
    "instrument_hash",
    "results_hash",
    "evaluated_at",
    "signature"
  ],
  "properties": {
    "pact": {
      "const": "0.2"
    },
    "type": {
      "const": "Verdict"
    },
    "vtc_id": {
      "type": "string"
    },
    "delivery_hash": {
      "$ref": "common.schema.json#/$defs/hash",
      "$comment": "The digest of the Delivery including its signature (Section 2)."
    },
    "challenge_hash": {
      "$ref": "common.schema.json#/$defs/hash",
      "$comment": "Present when the Verdict answers a Challenge (Section 7.2)."
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "profile": {
      "type": "string"
    },
    "instrument_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "results_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "evaluated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
