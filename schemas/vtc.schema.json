{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact-spec.github.io/spec/schemas/vtc.schema.json",
  "title": "PACT Verifiable Task Contract",
  "type": "object",
  "required": [
    "pact",
    "type",
    "id",
    "parties",
    "task",
    "price",
    "verification",
    "assurance",
    "release",
    "liability",
    "challenge",
    "signatures"
  ],
  "properties": {
    "pact": {
      "type": "string"
    },
    "type": {
      "const": "VerifiableTaskContract"
    },
    "id": {
      "type": "string"
    },
    "parties": {
      "type": "object",
      "required": [
        "buyer",
        "seller",
        "facilitator"
      ],
      "properties": {
        "buyer": {
          "$ref": "common.schema.json#/$defs/did"
        },
        "seller": {
          "$ref": "common.schema.json#/$defs/did"
        },
        "facilitator": {
          "$ref": "common.schema.json#/$defs/did"
        },
        "verifier": {
          "$ref": "common.schema.json#/$defs/did"
        }
      },
      "$comment": "buyer and seller MUST be distinct. JSON Schema cannot compare sibling values, so tools/validate.py enforces it: a self-dealt contract otherwise validates and satisfies the two-signature rule with one key signing twice."
    },
    "task": {
      "type": "object",
      "required": [
        "spec_hash",
        "deadline"
      ],
      "properties": {
        "spec_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "spec_uri": {
          "type": "string",
          "format": "uri"
        },
        "deadline": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "price": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "settlement"
      ],
      "properties": {
        "amount": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "currency": {
          "type": "string"
        },
        "settlement": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "tier",
        "criteria_hash",
        "profile"
      ],
      "properties": {
        "tier": {
          "$ref": "common.schema.json#/$defs/tier"
        },
        "criteria_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "arbiter": {
          "$ref": "common.schema.json#/$defs/did"
        },
        "profile": {
          "type": "string"
        }
      }
    },
    "liability": {
      "$ref": "common.schema.json#/$defs/liability"
    },
    "challenge": {
      "$ref": "common.schema.json#/$defs/challenge"
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "common.schema.json#/$defs/signature"
      },
      "$comment": "minItems does not express the actual rule, which is one signature per party named in parties. Two buyer signatures and no seller signature satisfy this schema; tools/validate.py enforces the real rule."
    },
    "assurance": {
      "$ref": "common.schema.json#/$defs/assurance"
    },
    "release": {
      "$ref": "common.schema.json#/$defs/release_mode"
    }
  }
}
