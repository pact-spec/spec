{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge.schema.json",
  "title": "PACT Challenge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pact",
    "type",
    "vtc_id",
    "delivery_hash",
    "proof",
    "signature"
  ],
  "properties": {
    "pact": {
      "type": "string"
    },
    "type": {
      "const": "Challenge"
    },
    "vtc_id": {
      "type": "string"
    },
    "delivery_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "proof": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "instrument_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_uri": {
          "type": "string",
          "format": "uri"
        },
        "failing_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "$comment": "Section 7.5. Profile-conditional members enforced in code.",
      "additionalProperties": false
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
