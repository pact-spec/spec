{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer record (input)",
  "type": "object",
  "required": ["customer_id", "email", "country", "updated_at"],
  "properties": {
    "customer_id": { "type": "string" },
    "email": { "type": "string" },
    "country": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
