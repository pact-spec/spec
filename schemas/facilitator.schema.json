{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facilitator.schema.json",
  "title": "PACT Facilitator Capability Document (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pact",
    "type",
    "facilitator",
    "settlement_bindings",
    "flows",
    "verification_profiles",
    "terms_profiles",
    "endpoints",
    "signature"
  ],
  "properties": {
    "pact": {
      "const": "0.2"
    },
    "type": {
      "const": "FacilitatorCapabilities"
    },
    "facilitator": {
      "$ref": "common.schema.json#/$defs/party"
    },
    "settlement_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "networks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "const": "verdict-first"
      },
      "items": {
        "$ref": "common.schema.json#/$defs/flow"
      },
      "$comment": "Section 7.1: verdict-first is REQUIRED to implement."
    },
    "verification_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "terms_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "profile_hash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "profile_hash": {
            "$ref": "common.schema.json#/$defs/hash"
          }
        },
        "additionalProperties": false
      },
      "$comment": "Section 8: the terms profiles, at the revisions named, whose schedules this Facilitator evaluates and whose vectors it reproduces."
    },
    "max_contract_value": {
      "$ref": "common.schema.json#/$defs/amount_with_currency"
    },
    "challenge_deposit": {
      "$ref": "common.schema.json#/$defs/amount_with_currency",
      "$comment": "Section 7.3. Absent means no deposit is required."
    },
    "endpoints": {
      "type": "object",
      "required": [
        "contract",
        "delivery",
        "verdict",
        "challenge",
        "outcome"
      ],
      "additionalProperties": {
        "type": "string",
        "format": "uri"
      }
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
