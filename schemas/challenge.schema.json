{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "challenge.schema.json",
  "title": "PACT Challenge (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pact",
    "type",
    "vtc_id",
    "delivery_hash",
    "proof",
    "signature"
  ],
  "properties": {
    "pact": {
      "const": "0.2"
    },
    "type": {
      "const": "Challenge"
    },
    "vtc_id": {
      "type": "string"
    },
    "delivery_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "proof": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "instrument_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_uri": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "failing_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "$comment": "Section 7.3. Profile-conditional members enforced in code. Members beyond those named are the verification profile's (Section 2); for acceptance, instrument_hash and results_hash are required.",
      "additionalProperties": true,
      "if": {
        "properties": {
          "profile": {
            "const": "acceptance"
          }
        }
      },
      "then": {
        "required": [
          "profile",
          "instrument_hash",
          "results_hash"
        ]
      }
    },
    "costs": {
      "$ref": "common.schema.json#/$defs/amount_with_currency",
      "$comment": "Section 3.6: a figure the Challenger asserts; recorded in the trace and read by the terms profile only."
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
