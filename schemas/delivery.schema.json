{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery.schema.json",
  "title": "PACT Delivery (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pact",
    "type",
    "vtc_id",
    "vtc_hash",
    "work_hash",
    "evidence",
    "signature"
  ],
  "properties": {
    "pact": {
      "const": "0.2"
    },
    "type": {
      "const": "Delivery"
    },
    "vtc_id": {
      "type": "string"
    },
    "vtc_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "work_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "work_uri": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "input_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "evidence": {
      "type": "object",
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string"
        },
        "instrument_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "results_uri": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        }
      },
      "$comment": "Section 6. Tier- and profile-conditional members are enforced in code. delivered_at is gone: the trace carries the Facilitator's time. Members beyond those named are the verification profile's (Section 2); for acceptance, instrument_hash and results_hash are required.",
      "additionalProperties": true,
      "if": {
        "properties": {
          "profile": {
            "const": "acceptance"
          }
        }
      },
      "then": {
        "required": [
          "profile",
          "instrument_hash",
          "results_hash"
        ]
      }
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature"
    }
  }
}
