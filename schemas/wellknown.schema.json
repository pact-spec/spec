{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact-spec.github.io/spec/schemas/wellknown.schema.json",
  "title": "PACT well-known capability document",
  "type": "object",
  "required": ["pactVersion", "roles", "verification_tiers", "settlement"],
  "properties": {
    "pactVersion": { "type": "string" },
    "roles": { "type": "array",
      "items": { "enum": ["buyer", "seller"] }, "minItems": 1 },
    "verification_tiers": { "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/tier" } },
    "settlement": { "type": "array", "items": { "type": "string" } },
    "channels": { "type": "boolean" },
    "min_bond_pct": { "type": "number", "minimum": 0,
      "$comment": "The 100 percent ceiling was removed. Bond sizing is driven by expected harm and by the assurance constraint, not by price, and both routinely require a bond above the contract price; the ceiling forbade the only sound parameterizations. See https://github.com/pact-spec/spec/issues/1 entries 9 and 10." },
    "attestation_jwks": { "type": "string", "format": "uri" }
  }
}
