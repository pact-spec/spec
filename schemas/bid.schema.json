{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact-spec.github.io/spec/schemas/bid.schema.json",
  "title": "PACT Bid",
  "type": "object",
  "required": ["pact", "type", "cfb_id", "bidder", "commitment", "signatures"],
  "properties": {
    "pact": { "type": "string" },
    "type": { "const": "Bid" },
    "cfb_id": { "type": "string" },
    "bidder": { "$ref": "common.schema.json#/$defs/did" },
    "commitment": { "$ref": "common.schema.json#/$defs/hash" },
    "signatures": { "type": "array", "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/signature" } }
  }
}
