{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "PACT Contract Status (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pact",
    "type",
    "vtc_id",
    "vtc_hash",
    "state",
    "trace",
    "issued_at",
    "signature"
  ],
  "properties": {
    "pact": {
      "const": "0.2"
    },
    "type": {
      "const": "ContractStatus"
    },
    "vtc_id": {
      "type": "string"
    },
    "vtc_hash": {
      "$ref": "common.schema.json#/$defs/hash"
    },
    "state": {
      "$ref": "common.schema.json#/$defs/state"
    },
    "trace": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/trace_entry"
      },
      "$comment": "Section 11: the trace so far, in the order recorded; a prefix of every later Status for the same contract."
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "signature": {
      "$ref": "common.schema.json#/$defs/signature",
      "$comment": "The Facilitator's."
    }
  }
}
