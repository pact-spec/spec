{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact-spec.github.io/spec/schemas/vtc.schema.json",
  "title": "PACT Verifiable Task Contract (0.3)",
  "type": "object",
  "required": [
    "pact",
    "type",
    "id",
    "parties",
    "task",
    "price",
    "verification",
    "flow",
    "terms",
    "challenge",
    "signatures"
  ],
  "properties": {
    "pact": {
      "const": "0.3"
    },
    "type": {
      "const": "VerifiableTaskContract"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "enum": [
          ".",
          ".."
        ]
      }
    },
    "parties": {
      "$ref": "common.schema.json#/$defs/parties"
    },
    "task": {
      "type": "object",
      "required": [
        "spec_hash",
        "deadline"
      ],
      "properties": {
        "spec_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "spec_uri": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "deadline": {
          "$ref": "common.schema.json#/$defs/timestamp"
        }
      },
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "required": [
        "amount",
        "currency",
        "settlement",
        "network"
      ],
      "properties": {
        "amount": {
          "$ref": "common.schema.json#/$defs/money"
        },
        "currency": {
          "type": "string"
        },
        "settlement": {
          "type": "string",
          "minLength": 1,
          "$comment": "A URI naming a settlement binding (Section 3.2). No registry."
        },
        "network": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "verification": {
      "$ref": "common.schema.json#/$defs/verification"
    },
    "flow": {
      "$ref": "common.schema.json#/$defs/flow"
    },
    "terms": {
      "$ref": "common.schema.json#/$defs/terms"
    },
    "challenge": {
      "$ref": "common.schema.json#/$defs/challenge"
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/parent"
    },
    "signatures": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "common.schema.json#/$defs/signature"
      },
      "$comment": "Exactly one entry covering parties.buyer and one covering parties.seller, sorted by normalized kid; minItems cannot say that, code does (Section 14.1, 14.2)."
    }
  },
  "additionalProperties": false
}
