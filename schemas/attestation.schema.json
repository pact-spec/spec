{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pact-spec.github.io/spec/schemas/attestation.schema.json",
  "title": "PACT Work Attestation",
  "type": "object",
  "required": ["pact", "type", "vtc_id", "vtc_hash", "outcome",
               "amount_settled", "currency", "settled_at", "signatures"],
  "properties": {
    "pact": { "type": "string" },
    "type": { "const": "WorkAttestation" },
    "vtc_id": { "type": "string" },
    "vtc_hash": { "$ref": "common.schema.json#/$defs/hash" },
    "outcome": { "enum": ["settled", "cured", "slashed", "arbitrated"] },
    "amount_settled": { "$ref": "common.schema.json#/$defs/money" },
    "currency": { "type": "string" },
    "opened_at": { "type": "string", "format": "date-time" },
    "settled_at": { "type": "string", "format": "date-time" },
    "children_merkle_root": {
      "oneOf": [ { "$ref": "common.schema.json#/$defs/hash" }, { "type": "null" } ] },
    "signatures": { "type": "array", "minItems": 2,
      "items": { "$ref": "common.schema.json#/$defs/signature" } }
  }
}
